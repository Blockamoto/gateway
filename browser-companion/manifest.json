{
  "manifest_version": 3,
  "name": "Gateway Browser Companion",
  "version": "0.7.0",
  "description": "Recovers exact Gateway resource addresses when a Chromium browser treats them as searches.",
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.uk/search*",
        "https://www.bing.com/search*",
        "https://duckduckgo.com/*",
        "https://search.brave.com/search*"
      ],
      "js": [
        "search.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "Gateway Client",
    "default_popup": "popup.html"
  }
}
