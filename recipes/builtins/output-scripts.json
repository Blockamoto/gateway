{
  "format": "gateway-recipe",
  "version": 1,
  "id": "output-scripts",
  "name": "Retained output scripts",
  "source": "bitcoin.ordered",
  "origin": 0,
  "history": "sparse",
  "storage": "rows.json.v1",
  "dependencies": [],
  "tables": [
    {
      "name": "outputs",
      "key": "ref"
    }
  ],
  "ordered": {
    "steps": [
      {
        "op": "for_events",
        "body": [
          {
            "op": "if",
            "expr": {
              "call": "eq",
              "args": [
                {
                  "field": "kind"
                },
                {
                  "literal": {
                    "kind": "text",
                    "text": "output"
                  }
                }
              ]
            },
            "body": [
              {
                "op": "let",
                "name": "ref",
                "expr": {
                  "call": "output_ref",
                  "args": [
                    {
                      "field": "height"
                    },
                    {
                      "field": "tx_index"
                    },
                    {
                      "field": "vout"
                    }
                  ]
                }
              },
              {
                "op": "emit",
                "table": "outputs",
                "key": {
                  "var": "ref"
                },
                "expr": {
                  "object": {
                    "ref": {
                      "var": "ref"
                    },
                    "block_hash": {
                      "field": "block"
                    },
                    "script": {
                      "field": "script"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
